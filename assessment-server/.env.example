# 本地使用。生产请设 NODE_ENV=production，APP_ORIGIN=https://你的域名
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# 必填：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# 仅本机反向代理可设 loopback；Linux Docker 示例自动使用 loopback
TRUST_PROXY=false
# 每IP每分钟认证总请求上限；登录端点另有保护
AUTH_RATE_LIMIT=120
# 唯一只读管理员：先自行注册，再填写该账号的不可变用户ID；留空为无人有管理员权限
ADMIN_USER_ID=
